# Backend API Base URL
# In development: Leave empty to use Vite proxy (recommended)
# In production: Set to your backend URL (e.g., https://api.yourdomain.com/api)
# VITE_API_BASE_URL=/api

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=volunteerhub-af843.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=volunteerhub-af843
VITE_FIREBASE_STORAGE_BUCKET=volunteerhub-af843.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# VAPID Key for Web Push notifications
# Get from: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
